---
const education = [
  {
    title: 'Ingeniero Multimedia',
    institution: 'Centro Regional de Estudios Superiores Palmore',
    location: 'Chihuahua, Chihuahua',
    period: 'Agosto 2018 — Junio 2022',
    icon: 'fa-graduation-cap'
  },
  {
    title: 'Bootcamp Data Analytics',
    institution: 'Universidad del Valle de México',
    location: 'México',
    period: 'Enero 2026 — Agosto 2026',
    icon: 'fa-book-open'
  }
];
---

<section class="py-16 sm:py-20">
  <div class="mb-8 animate-enter">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-400">
      Mi preparación
    </p>
    <h2 class="mt-3 font-title text-3xl font-bold text-white sm:text-4xl">
      Formación académica
    </h2>
  </div>

  <div class="space-y-4">
    {education.map((item, index) => (
      <article
        class="group relative overflow-hidden rounded-2xl border border-slate-700/80 bg-container p-6 transition-all duration-300 hover:border-secondary/40 hover:shadow-xl hover:shadow-black/20 sm:p-8 animate-slide-down"
        style={`animation-delay: ${index * 100}ms`}
      >
        <div class="absolute inset-y-0 left-0 w-1 bg-secondary/70 transition-all duration-300 group-hover:w-1.5"></div>

        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-secondary/10 text-secondary transition-transform duration-300 group-hover:scale-105">
            <i class={`fa-solid ${item.icon} text-2xl`}></i>
          </div>

          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-secondary">
              {item.period}
            </p>

            <h3 class="mt-2 font-title text-xl font-semibold text-white sm:text-2xl">
              {item.title}
            </h3>

            <p class="mt-2 text-slate-300">
              {item.institution}
            </p>

            <p class="mt-1 text-sm text-slate-400">
              <i class="fa-solid fa-location-dot mr-2"></i>
              {item.location}
            </p>
          </div>

        </div>
      </article>
    ))}
  </div>
</section>
