---
type Props = {
  company: string;
  role: string;
  period: string;
  tasks: string[];
  technologies?: string[];
  category?: string;
  icon?: string;
  bgColor?: string;
  textColor?: string;
  classProp?: string;
};

const {
  company,
  role,
  period,
  tasks,
  technologies = [],
  category = "Experiencia profesional",
  icon = "fa-briefcase",
  bgColor = "bg-container",
  textColor = "text-text",
  classProp = "",
}: Props = Astro.props;
---

<article
  class:list={[
    "group relative overflow-hidden rounded-2xl border border-border/80",
    "p-5 sm:p-6 lg:p-8",
    "shadow-lg shadow-black/10 transition-all duration-300",
    "hover:-translate-y-1 hover:border-secondary/40 hover:shadow-xl",
    bgColor,
    textColor,
    classProp,
  ]}
>
  <div class="absolute left-0 top-0 h-full w-1 origin-top scale-y-0 bg-secondary transition-transform duration-300 group-hover:scale-y-100"></div>

  <div class="flex flex-col gap-4 border-b border-border/70 pb-5 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
    <div class="flex items-start gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-secondary/20 bg-secondary/10 text-secondary sm:h-14 sm:w-14">
        <i class={`fa-solid ${icon} text-xl sm:text-2xl`}></i>
      </div>

      <div class="min-w-0">
        <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-secondary sm:text-sm">
          {category}
        </p>

        <h2 class="font-title text-xl font-bold leading-tight text-white sm:text-2xl lg:text-3xl">
          {company}
        </h2>

        <p class="mt-1 font-title text-base font-medium text-secondary sm:text-lg">
          {role}
        </p>
      </div>
    </div>

    <div class="flex w-fit shrink-0 items-center gap-2 rounded-lg border border-border/70 bg-background/60 px-3 py-2 text-sm text-text-muted">
      <i class="fa-regular fa-calendar text-secondary"></i>
      <span>{period}</span>
    </div>
  </div>

  <div class:list={[
    "mt-5 grid grid-cols-1 gap-5",
    technologies.length > 0 ? "lg:grid-cols-12 lg:gap-6" : "",
  ]}>
    <div class:list={[
      technologies.length > 0 ? "lg:col-span-7" : "",
    ]}>
      <h3 class="mb-4 flex items-center gap-2 font-title text-sm font-semibold uppercase tracking-wider text-text-muted">
        <i class="fa-solid fa-list-check text-secondary"></i>
        Responsabilidades clave
      </h3>

      <ul class="space-y-3">
        {tasks.map((task) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-text-muted sm:text-base">
            <i class="fa-solid fa-check mt-1 text-xs text-secondary"></i>
            <span>{task}</span>
          </li>
        ))}
      </ul>
    </div>

    {technologies.length > 0 && (
      <div class="rounded-xl border border-border/50 bg-background/40 p-4 sm:p-5 lg:col-span-5">
        <h3 class="mb-4 flex items-center gap-2 font-title text-sm font-semibold uppercase tracking-wider text-text-muted">
          <i class="fa-solid fa-layer-group text-secondary"></i>
          Tecnologías y herramientas
        </h3>

        <div class="flex flex-wrap gap-2">
          {technologies.map((technology) => (
            <span class="rounded-lg border border-border/60 bg-container px-3 py-1.5 text-xs font-medium text-text sm:text-sm">
              {technology}
            </span>
          ))}
        </div>
      </div>
    )}
  </div>
</article>