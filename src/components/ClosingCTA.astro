---
const {
  eyebrow = '¿Qué sigue?',
  title = 'Conoce mi trabajo',
  description = 'Explora mi experiencia, las herramientas que he utilizado y los proyectos que forman parte de mi trayectoria.',
  primaryLabel = 'Ver experiencia',
  primaryHref = '/juan-wong-website/experience/',
  secondaryLabel = 'Contactarme',
  secondaryHref = '/juan-wong-website/contact/'
} = Astro.props;
---

<section class="pt-12 pb-4 sm:pt-16 sm:pb-2 animate-enter">
  <div class="group relative isolate overflow-hidden rounded-3xl border border-slate-700/80 bg-container px-6 py-10 transition-colors duration-300 hover:border-slate-600 sm:px-10 sm:py-12 lg:px-14 lg:py-14">
    <!-- Iluminación decorativa -->
    <div class="pointer-events-none absolute -right-16 -top-20 -z-10 h-64 w-64 rounded-full bg-sky-400/10 blur-3xl transition-opacity duration-500 group-hover:bg-sky-400/15 animate-breathe"></div>
    <div class="pointer-events-none absolute -bottom-24 left-1/4 -z-10 h-64 w-64 rounded-full bg-secondary/10 blur-3xl animate-breathe animate-delay-3"></div>

    <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-secondary">
          {eyebrow}
        </p>

        <h2 class="mt-4 font-title text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
          {title}
        </h2>

        <p class="mt-5 max-w-xl text-base leading-7 text-slate-300 sm:text-lg">
          {description}
        </p>
      </div>

      <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
        <a
          href={primaryHref}
          class="inline-flex items-center justify-center rounded-xl bg-secondary px-6 py-3.5 font-semibold text-slate-950 transition-all duration-200 hover:-translate-y-0.5 hover:bg-amber-300"
        >
          {primaryLabel}
          <i class="fa-solid fa-arrow-right ml-2 transition-transform duration-200 group-hover:translate-x-0.5"></i>
        </a>

        <a
          href={secondaryHref}
          class="inline-flex items-center justify-center rounded-xl border border-slate-600 bg-slate-950/20 px-6 py-3.5 font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:border-sky-400 hover:text-sky-400"
        >
          {secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
