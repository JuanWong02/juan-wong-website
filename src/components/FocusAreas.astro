---
const areas = [
  {
    title: 'Edición audiovisual',
    description: 'Edición y creación de contenido visual para comunicar ideas de manera clara y atractiva.',
    icon: 'fa-film',
    accent: 'amber',
    tags: ['Video', 'Imagen', 'Edición']
  },
  {
    title: 'Diseño multimedia',
    description: 'Diseño gráfico y elaboración de recursos visuales para proyectos y comunicaciones.',
    icon: 'fa-pen-ruler',
    accent: 'sky',
    tags: ['Diseño gráfico', 'Comunicación visual']
  },
  {
    title: 'Ingeniería de audio',
    description: 'Interés en el trabajo con audio como parte de la creación de contenido multimedia.',
    icon: 'fa-wave-square',
    accent: 'amber',
    tags: ['Audio', 'Producción multimedia']
  },
  {
    title: 'Programación',
    description: 'Desarrollo y mantenimiento de soluciones, análisis de datos y resolución de problemas técnicos.',
    icon: 'fa-code',
    accent: 'sky',
    tags: ['JavaScript', 'SQL', 'Python']
  }
];
---

<section class="py-16 sm:py-20">
  <div class="mb-10 max-w-2xl animate-enter">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-400">
      Lo que me gusta hacer
    </p>
    <h2 class="mt-3 font-title text-3xl font-bold text-white sm:text-4xl">
      Áreas de enfoque multimedia
    </h2>
    <p class="mt-4 leading-7 text-slate-400">
      Disciplinas que combinan creatividad, herramientas digitales y conocimientos técnicos.
    </p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    {areas.map((area, index) => (
      <article
        class:list={[
          'group rounded-2xl border bg-container p-6',
          'transition-all duration-300 ease-out',
          'hover:-translate-y-1 hover:shadow-xl hover:shadow-black/20',
          'animate-slide-down',
          area.accent === 'amber'
            ? 'border-slate-700/80 hover:border-secondary/60'
            : 'border-slate-700/80 hover:border-sky-400/60'
        ]}
        style={`animation-delay: ${index * 100}ms`}
      >
        <div
          class:list={[
            'mb-5 flex h-12 w-12 items-center justify-center rounded-xl transition-transform duration-300 group-hover:scale-110',
            area.accent === 'amber'
              ? 'bg-secondary/10 text-secondary'
              : 'bg-sky-400/10 text-sky-400'
          ]}
        >
          <i class={`fa-solid ${area.icon} text-xl`}></i>
        </div>

        <h3 class="font-title text-xl font-semibold text-white">
          {area.title}
        </h3>

        <p class="mt-3 min-h-20 text-sm leading-6 text-slate-400">
          {area.description}
        </p>

        <div class="mt-5 flex flex-wrap gap-2">
          {area.tags.map((tag) => (
            <span
              class:list={[
                'rounded-md border px-2.5 py-1 text-xs font-medium',
                area.accent === 'amber'
                  ? 'border-secondary/20 bg-secondary/5 text-amber-300'
                  : 'border-sky-400/20 bg-sky-400/5 text-sky-300'
              ]}
            >
              {tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
