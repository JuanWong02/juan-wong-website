---
const characteristics = [
  { name: 'Responsable', icon: 'fa-shield-halved' },
  { name: 'Honesto', icon: 'fa-handshake' },
  { name: 'Dedicado', icon: 'fa-bullseye' },
  { name: 'Puntual', icon: 'fa-clock' },
  { name: 'Ordenado', icon: 'fa-list-check' }
];
---

<section class="py-16 sm:py-20">
  <div class="mb-10 animate-enter">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-400">
      Mi forma de trabajar
    </p>

    <h2 class="mt-3 font-title text-3xl font-bold text-white sm:text-4xl">
      Características personales
    </h2>

    <p class="mt-4 max-w-2xl leading-7 text-slate-400">
      Cualidades que procuro aportar a cada proyecto y a mi trabajo diario.
    </p>
  </div>

  
<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
  {characteristics.map((item, index) => (
    <article
      class="group relative flex flex-col items-center overflow-hidden rounded-2xl border border-slate-700/80 bg-container px-4 py-7 text-center transition-all duration-300 ease-out hover:-translate-y-1 hover:border-secondary/50 hover:shadow-lg hover:shadow-black/20 sm:px-6 sm:py-8 animate-slide-down"
      style={`animation-delay: ${index * 100}ms`}
    >
      <div class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-secondary transition-transform duration-300 group-hover:scale-x-100"></div>

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-secondary/10 text-secondary transition-all duration-300 group-hover:scale-110 group-hover:bg-secondary/15">
        <i class={`fa-solid ${item.icon} text-2xl sm:text-3xl`}></i>
      </div>

      <h3 class="mt-5 font-title text-base font-semibold text-white sm:text-lg">
        {item.name}
      </h3>
    </article>
  ))}
</div>
</section>
