---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ContactImg from '../assets/img/contact-image.webp';
---

<Layout title="Ing. Juan Carlos Wong Reyes | Contacto">
  <section class="mx-auto grid w-full max-w-screen-2xl grid-cols-1 items-stretch gap-10 overflow-hidden px-6 py-12 text-text md:px-10 lg:grid-cols-12 lg:gap-12 lg:px-12 lg:py-16">

    <!-- Fotografía y presentación -->
    <div class="animate-enter flex lg:col-span-5">
      <div class="relative mx-auto flex w-full max-w-md flex-col lg:max-w-none">
        <div class="absolute -inset-3 rounded-3xl border border-secondary/20"></div>

        <div class="absolute -right-4 -top-4 h-24 w-24 rounded-full bg-secondary/10 blur-2xl"></div>
        <div class="absolute -bottom-4 -left-4 h-24 w-24 rounded-full bg-accent/10 blur-2xl"></div>

        <div class="relative flex-1 overflow-hidden rounded-2xl border border-border bg-container p-2 shadow-xl">
          <Image
            src={ContactImg}
            alt="Retrato de Juan Carlos Wong Reyes"
            widths={[320,480,640,800,960]}
            sizes="(max-width: 768px) 100vw, 651px"
            format='webp'
            quality={80}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-full min-h-[420px] w-full rounded-xl object-cover object-center transition-transform duration-500 ease-out hover:scale-[1.02] lg:min-h-[600px]"
          />

          <div class="absolute inset-x-2 bottom-2 rounded-b-xl bg-gradient-to-t from-background via-background/90 to-transparent px-5 pb-5 pt-12">
            <p class="font-title text-xl font-bold text-white sm:text-2xl">
              Juan Carlos Wong Reyes
            </p>
            <p class="mt-1 text-sm text-text-muted sm:text-base">
              Ingeniero Multimedia · Desarrollo y contenido digital
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Contacto y enlaces -->
    <div class="flex flex-col gap-10 lg:col-span-7 lg:gap-12">

      <!-- Introducción -->
      <div class="animate-enter animate-delay-1">
        <div class="mb-5 inline-flex items-center gap-3 rounded-full border border-secondary/20 bg-secondary/10 px-4 py-2">
          <span class="h-2 w-2 rounded-full bg-secondary animate-breathe"></span>
          <p class="font-title text-xs font-semibold uppercase tracking-[0.2em] text-secondary sm:text-sm">
          Canales de contacto y redes
          </p>
        </div>

        <h1 class="font-title text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl xl:text-6xl">
          ¿Interesado en
          <span class="text-secondary">mi trabajo?</span>
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-7 text-text-muted sm:text-lg sm:leading-8">
          Si quieres conocer más sobre mi experiencia en software empresarial,
          desarrollo web o producción multimedia, puedes contactarme mediante
          el siguiente formulario.
        </p>
      </div>

      <!-- Formulario -->
      <div class="animate-enter animate-delay-2 rounded-2xl border border-border bg-container p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
            <i class="fa-regular fa-envelope text-xl"></i>
          </div>

          <div class="min-w-0 flex-1">
            <h2 class="font-title text-xl font-bold text-white sm:text-2xl">
              ¡Contáctame!
            </h2>
            <p class="mt-2 text-sm leading-6 text-text-muted sm:text-base">
              Envíame un mensaje con los detalles de tu propuesta o consulta.
            </p>
          </div>
        </div>

        <a
          href="https://forms.gle/DuSitC6zwLM9ZTRE7"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 flex w-full items-center justify-center gap-3 rounded-xl bg-secondary px-5 py-4 font-title font-bold text-background transition-all duration-300 hover:-translate-y-0.5 hover:bg-amber-300 hover:shadow-lg hover:shadow-secondary/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary sm:w-fit"
        >
          <span>Abrir formulario de contacto</span>
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </a>
      </div>

      <!-- Portafolio y perfiles -->
      <div class="animate-enter animate-delay-3">
        <div class="mb-5">
          <p class="font-title text-xs font-semibold uppercase tracking-[0.2em] text-secondary">
            Portafolio y perfiles
          </p>
          <h2 class="mt-2 font-title text-2xl font-bold text-white sm:text-3xl">
            Mi trabajo y credenciales
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">

          <a
            href="https://www.behance.net/juanwong6"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-xl border border-border bg-container p-4 transition-all duration-300 hover:-translate-y-1 hover:border-secondary/50 hover:bg-secondary/5 sm:flex-col sm:items-start sm:p-5"
          >
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-secondary/10 text-secondary transition-colors duration-300 group-hover:bg-secondary group-hover:text-background">
              <i class="fa-brands fa-behance text-xl"></i>
            </div>
            <div>
              <h3 class="font-title font-bold text-white">Behance</h3>
              <p class="mt-1 text-sm leading-5 text-text-muted">
                Portafolio creativo y audiovisual
              </p>
            </div>
            <i class="fa-solid fa-arrow-up-right-from-square ml-auto text-xs text-text-muted transition-colors group-hover:text-secondary sm:ml-0 sm:mt-2"></i>
          </a>

          <a
            href="https://github.com/JuanWong02"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-xl border border-border bg-container p-4 transition-all duration-300 hover:-translate-y-1 hover:border-secondary/50 hover:bg-secondary/5 sm:flex-col sm:items-start sm:p-5"
          >
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-secondary/10 text-secondary transition-colors duration-300 group-hover:bg-secondary group-hover:text-background">
              <i class="fa-brands fa-github text-xl"></i>
            </div>
            <div>
              <h3 class="font-title font-bold text-white">GitHub</h3>
              <p class="mt-1 text-sm leading-5 text-text-muted">
                Repositorios y código
              </p>
            </div>
            <i class="fa-solid fa-arrow-up-right-from-square ml-auto text-xs text-text-muted transition-colors group-hover:text-secondary sm:ml-0 sm:mt-2"></i>
          </a>

          <a
            href="https://www.linkedin.com/in/juan-carlos-wong-reyes-74b4b120a/details/certifications/"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-xl border border-border bg-container p-4 transition-all duration-300 hover:-translate-y-1 hover:border-secondary/50 hover:bg-secondary/5 sm:flex-col sm:items-start sm:p-5"
          >
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-secondary/10 text-secondary transition-colors duration-300 group-hover:bg-secondary group-hover:text-background">
              <i class="fa-brands fa-linkedin text-xl"></i>
            </div>
            <div>
              <h3 class="font-title font-bold text-white">Certificaciones</h3>
              <p class="mt-1 text-sm leading-5 text-text-muted">
                Credenciales en LinkedIn
              </p>
            </div>
            <i class="fa-solid fa-arrow-up-right-from-square ml-auto text-xs text-text-muted transition-colors group-hover:text-secondary sm:ml-0 sm:mt-2"></i>
          </a>

        </div>
      </div>
    </div>
  </section>
</Layout>
