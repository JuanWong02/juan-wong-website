
---
import Layout from '../layouts/Layout.astro';
import FotoPerfil from '../assets/img/perfil.webp';
---

<Layout title="Ing. Juan Carlos Wong Reyes | Inicio">
  <main class="mx-auto max-w-7xl px-5 py-8 text-white sm:px-8 lg:px-12 lg:py-12">

    <!-- Presentación principal -->
    <section class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
      <div class="order-2 space-y-6 md:order-1 animate-slide-left">
        <p class="font-text text-sm font-semibold uppercase tracking-[0.25em] text-secondary">
          Portafolio personal
        </p>

        <h1 class="font-title text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
          Juan Carlos Wong Reyes
        </h1>

        <h2 class="font-title text-2xl font-medium text-secondary sm:text-3xl">
          Ingeniero Multimedia
        </h2>

        <p class="max-w-xl text-base leading-8 text-slate-300 sm:text-lg">
          Me apasiona crear, editar y transformar contenido multimedia.
          Disfruto trabajar con imagen, video y audio, así como explorar
          la programación para convertir ideas en soluciones concretas.
        </p>

        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="/juan-wong-website/experience/"
            class="inline-flex items-center justify-center rounded-xl bg-secondary px-6 py-3 font-semibold text-primary transition-transform duration-200 hover:-translate-y-1"
          >
            Ver experiencia
          </a>

          <a
            href="/juan-wong-website/contact/"
            class="inline-flex items-center justify-center rounded-xl border border-slate-600 px-6 py-3 font-semibold text-white transition-colors duration-200 hover:border-secondary hover:text-secondary"
          >
            Contactarme
          </a>
        </div>
      </div>

      <div class="order-1 flex justify-center md:order-2 animate-slide-right">
        <div class="relative w-full max-w-md">
          <div class="absolute -inset-3 rounded-3xl border border-secondary/30"></div>

          <img
            class="relative aspect-[4/5] max-h-[560px] w-full rounded-2xl object-cover shadow-2xl"
            src={FotoPerfil.src}
            alt="Fotografía de Juan Carlos Wong Reyes"
          />
        </div>
      </div>
    </section>

    <!-- Formación académica -->
    <section class="mt-24">
      <div class="mb-8">
        <p class="font-text text-sm font-semibold uppercase tracking-[0.2em] text-secondary">
          Mi trayectoria
        </p>
        <h2 class="mt-2 font-title text-3xl font-bold sm:text-4xl">
          Formación académica
        </h2>
      </div>

      <article class="rounded-2xl border border-slate-700/70 bg-container p-6 sm:p-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h3 class="font-title text-xl font-semibold sm:text-2xl">
              Ingeniero Multimedia
            </h3>
            <p class="mt-2 text-slate-300">
              Centro Regional de Estudios Superiores Palmore, Chihuahua
            </p>
          </div>

          <span class="w-fit rounded-full border border-secondary/30 px-4 py-2 text-sm text-secondary">
            2018 — 2022
          </span>
        </div>
      </article>
    </section>

    <!-- Características personales -->
    <section class="mt-24">
      <div class="mb-8">
        <p class="font-text text-sm font-semibold uppercase tracking-[0.2em] text-secondary">
          Mi forma de trabajar
        </p>
        <h2 class="mt-2 font-title text-3xl font-bold sm:text-4xl">
          Características
        </h2>
      </div>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {[
          'Responsable',
          'Honesto',
          'Dedicado',
          'Puntual',
          'Ordenado'
        ].map((caracteristica) => (
          <article class="rounded-2xl border border-slate-700/70 bg-container p-5 text-center transition-colors duration-200 hover:border-secondary/60">
            <p class="font-title text-base font-semibold sm:text-lg">
              {caracteristica}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Cierre -->
    <section class="mt-24 rounded-3xl border border-slate-700/70 bg-container px-6 py-12 text-center sm:px-12 sm:py-16">
      <p class="font-text text-sm font-semibold uppercase tracking-[0.2em] text-secondary">
        ¿Conocemos mi trabajo?
      </p>

      <h2 class="mx-auto mt-4 max-w-2xl font-title text-3xl font-bold sm:text-4xl">
        Descubre mi experiencia y los proyectos en los que he trabajado
      </h2>

      <p class="mx-auto mt-5 max-w-xl leading-7 text-slate-300">
        Explora las herramientas que utilizo y conoce más sobre mi perfil profesional.
      </p>

      <a
        href="/juan-wong-website/experience/"
        class="mt-8 inline-flex rounded-xl bg-secondary px-6 py-3 font-semibold text-primary transition-transform duration-200 hover:-translate-y-1"
      >
        Ver trabajos
      </a>
    </section>

  </main>
</Layout>
