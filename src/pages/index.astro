---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import FotoPerfil from '../assets/img/perfil.webp';
import FocusAreas  from '../components/FocusAreas.astro';
import Education  from '../components/Education.astro';
import Characteristics from '../components/Characteristics.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
---

<Layout title="Ing. Juan Carlos Wong Reyes | Inicio">
  <div class="mx-auto max-w-7xl px-5 pb-16 sm:px-8 lg:px-12">

    <!-- Presentación principal -->
    <section class="grid items-center gap-10 py-10 sm:py-16 lg:grid-cols-2 lg:gap-16 lg:py-20">
      <div class="order-2 flex flex-col items-start lg:order-1">
        <span class="mb-5 inline-flex items-center gap-2 rounded-full border border-secondary/30 bg-secondary/10 px-4 py-2 text-sm font-medium text-secondary">
          <span class="h-2 w-2 rounded-full bg-secondary animate-breathe"></span>
          Ingeniero Multimedia
        </span>

        
				<h1 class="font-title text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl xl:text-6xl">
					<span class="typing-line typing-first">Juan Carlos</span>
					<span class="typing-line typing-second text-secondary">Wong Reyes</span>
				</h1>

        <p class="mt-6 max-w-xl text-base leading-8 text-slate-300 sm:text-lg animate-enter">
          Me apasiona crear, editar y transformar ideas mediante el diseño, los medios audiovisuales y la programación. Disfruto desarrollar proyectos, resolver problemas y ver cómo una idea toma forma a través del trabajo y la creatividad.
        </p>

        <div class="mt-8 flex flex-wrap gap-4 animate-enter animate-delay-1">
          <a
            href="/juan-wong-website/experience/"
            class="inline-flex items-center justify-center rounded-xl bg-secondary px-6 py-3 font-semibold text-slate-950 transition-colors duration-200 hover:bg-amber-300"
          >
            Ver mi trabajo
            <i class="fa-solid fa-arrow-right ml-2"></i>
          </a>

          <a
            href="/juan-wong-website/contact/"
            class="inline-flex items-center justify-center rounded-xl border border-slate-600 px-6 py-3 font-semibold text-slate-200 transition-colors duration-200 hover:border-sky-400 hover:text-sky-400"
          >
            Contactarme
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-3 animate-enter animate-delay-2">
          <span class="rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2 text-sm text-slate-300">Diseño multimedia</span>
          <span class="rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2 text-sm text-slate-300">Edición audiovisual</span>
          <span class="rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2 text-sm text-slate-300">Programación</span>
        </div>
      </div>

      <div class="order-1 mx-auto mb-8 w-full max-w-md lg:order-2 lg:mb-0 lg:max-w-none">
        <div class="relative mx-auto max-w-sm">
          <div class="absolute -inset-3 rounded-3xl border border-secondary/20 animate-enter animate-delay-5"></div>
          <div class="absolute -right-5 -top-5 h-28 w-28 rounded-full bg-sky-400/10 blur-2xl animate-enter animate-delay-5"></div>

          <Image
            src={FotoPerfil}
            alt="Fotografía de Juan Carlos Wong Reyes"
            widths={[320,480,640,800,960]}
            sizes="(max-width: 768px) 100vw, 651px"
            format='webp'
            quality={80}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="relative aspect-[4/5] w-full rounded-3xl border border-slate-700 object-cover shadow-2xl transition-transform duration-500 ease-out hover:scale-[1.02] shadow-black/30 animate-enter"
          />

          <div class="absolute -bottom-5 left-4 right-4 rounded-2xl border border-slate-700 bg-slate-900/95 p-4 shadow-xl backdrop-blur-sm sm:left-6 sm:right-6 animate-enter animate-delay-4 transition-transform duration-500 ease-out hover:scale-[1.02]">
            <p class="font-title text-lg font-semibold text-white">Creatividad y tecnología</p>
            <p class="mt-1 text-sm text-slate-400">Diseño, contenido digital y desarrollo</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Áreas de enfoque -->
    <FocusAreas/>

    <!-- Formación académica -->
    <Education/>

    <!-- Características personales -->
    <Characteristics/>

    <!-- Cierre -->
    <ClosingCTA/>

  </div>
</Layout>
