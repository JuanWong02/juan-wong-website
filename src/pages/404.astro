---
import Layout from '../layouts/Layout.astro';
import NotFound from '../assets/img/not-found.webp';
import { Image } from 'astro:assets';

const title = 'Página no encontrada';
const message = 'Parece que te perdiste. Regresa al inicio y descubre más sobre mí.';
---

<Layout title={`Ing. Juan Carlos Wong Reyes | ${title}`} showHeader={true}>
  <section class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 py-12 text-center text-text">

    <div class="relative z-10 flex w-full max-w-2xl flex-col items-center">

      <p class="animate-enter mb-3 font-title text-xs font-semibold uppercase tracking-[0.25em] text-secondary sm:text-sm">
        Error 404
      </p>

      <h1 class="animate-enter animate-delay-1 font-title text-4xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
        Página no <span class="text-secondary">encontrada</span>
      </h1>

      <!-- Imagen  -->
      <div class="animate-enter animate-delay-2 relative my-10">
        <div class="pointer-events-none absolute inset-[-2rem] rounded-full bg-secondary/10 blur-3xl"></div>

        <div class="group relative h-44 w-44 overflow-hidden rounded-full border border-border bg-container shadow-xl shadow-black/20 transition-all duration-500 ease-out hover:scale-105 hover:-rotate-2 hover:border-secondary/70 sm:h-56 sm:w-56">
          <Image
            src={NotFound}
            alt="Ilustración tipo sketch de Juan Carlos Wong Reyes de perfil"
            class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-110"
            widths={[176, 224, 352, 448]}
            sizes="(min-width: 640px) 224px, 176px"
            quality={80}
          />
        </div>
      </div>

      <p class="animate-enter animate-delay-3 max-w-md text-base leading-relaxed text-text-muted sm:text-lg">
        {message}
      </p>

      <!-- Botón de regreso -->
   
      <a
        href="/juan-wong-website/"
        class="animate-enter animate-delay-4 mt-8 inline-flex items-center justify-center gap-3 rounded-xl bg-secondary px-6 py-3.5 font-title text-sm font-bold text-background transition-all duration-300 hover:-translate-y-0.5 hover:bg-amber-300 hover:shadow-lg hover:shadow-secondary/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary sm:w-fit"
      >
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      Volver al inicio
      </a>


    </div>
  </section>
</Layout>
