---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import IconImg from '../assets/img/logo-principal.webp'

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Página de presentación de Juan Carlos Wong Reyes" />
    <link rel="icon" type="image/webp" href={IconImg.src} />
    <script src="https://kit.fontawesome.com/43e48c909b.js" crossorigin="anonymous" defer></script>
    <title>{title || 'Ing. Juan Carlos Wong Reyes'}</title>
  </head>

  <body id="top" class="min-h-screen flex flex-col bg-background text-text">
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
